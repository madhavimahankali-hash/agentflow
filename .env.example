# "fake" runs fully offline with deterministic agents (no AWS needed).
# "bedrock" uses Amazon Bedrock models for planning, research/analysis reasoning and summaries.
LLM_PROVIDER=fake

AWS_REGION=us-east-1
# If you sign in with AWS SSO / named profiles, set the profile to use:
# AWS_PROFILE=my-profile
# Use model IDs / inference profile IDs that are enabled in YOUR Bedrock console (Model access page).
SUPERVISOR_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
WORKER_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Where SQLite files (checkpoints, execution history, mock systems) are stored
DATA_DIR=./data

# "policy" = only high-risk actions need approval; "strict" = medium-risk actions too
APPROVAL_MODE=policy
PAYMENT_APPROVAL_THRESHOLD=1000
APPROVAL_TTL_HOURS=24
INTERNAL_EMAIL_DOMAIN=example.com
MAX_STEPS=25

# Optional real integrations (leave empty to use mocks)
OPENSANCTIONS_API_KEY=
SLACK_WEBHOOK_URL=
